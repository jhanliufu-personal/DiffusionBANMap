{
    "experiment_name": "diffusion_overfit_cfd",
    "output_dir": "outputs/diffusion_overfit_cfd",

    "train_dataset_path": "./datasets/overfit_cfd_train.pkl",
    "test_dataset_path": "./datasets/overfit_cfd_val.pkl",
    "batch_size": 8,

    "in_channels": 3,
    "image_size": 64,
    "model_channels": 64,
    "channel_mult": [1, 2, 4],
    "num_res_blocks": 2,
    "attention_resolutions": [16],
    "dropout": 0.0,

    "betavae_config_path": "outputs/betavae_full_cfd/config.json",
    "betavae_ckpt_path": "outputs/betavae_full_cfd/checkpoints/betavae_full_cfd_step200.pt",
    "latent_dim": 10,

    "num_timesteps": 1000,
    "beta_schedule": "cosine",

    "lr": 2e-4,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0,

    "num_steps": 2000,
    "log_interval": 10,
    "eval_interval": 200,
    "ckpt_interval": 2000
}
